<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Project3.ConferenceEditPage"
             Title="Конференція">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="10">
			<Label x:Name="lblPageTitle" Text="Додавання конференції" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

			<Label Text="Назва:" FontAttributes="Bold" />
			<Entry x:Name="txtTitle" Placeholder="Введіть назву конференції" />

			<Label Text="Тематика (галузь):" FontAttributes="Bold" />
			<Entry x:Name="txtField" Placeholder="Наприклад: Комп'ютерні науки" />

			<Label Text="Організатор:" FontAttributes="Bold" />
			<Entry x:Name="txtOrganizer" Placeholder="Університет / Інститут" />

			<Label Text="Місце проведення:" FontAttributes="Bold" />
			<Entry x:Name="txtLocation" Placeholder="Місто, адреса або Онлайн" />

			<Label Text="Терміни проведення:" FontAttributes="Bold" />
			<Entry x:Name="txtStartDate" Placeholder="Наприклад: 15.05.2026 - 17.05.2026" />

			<Label Text="Дедлайн подачі рукописів:" FontAttributes="Bold" />
			<DatePicker x:Name="dtpDeadline" Format="dd.MM.yyyy" />

			<Label Text="Вартість участі (грн):" FontAttributes="Bold" />
			<Entry x:Name="txtFee" Keyboard="Numeric" Placeholder="0" />

			<Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">
				<Button Grid.Column="0" Text="Зберегти" Clicked="OnSaveClicked" BackgroundColor="#107c41" TextColor="White" />
				<Button Grid.Column="1" Text="Скасувати" Clicked="OnCancelClicked" BackgroundColor="#a80000" TextColor="White" />
			</Grid>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
